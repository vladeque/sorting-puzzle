; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SortingPuzzle"
config/version="0.1.0"
run/main_scene="res://scenes/app_launch_router.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"
config/backend_base_url=""
config/save_sync_v2_enabled=false
config/secure_storage_bridge_singleton=""
config/build_number=1
config/leaderboard_provider="mock"
config/store_provider="mock"
config/mock_store_country="US"
config/shop_catalog_source="local"
config/ad_provider="disabled"
config/ad_allow_mock_provider=false
config/ad_native_integration_enabled=false
config/ad_privacy_policy_url=""
config/support_email="support@sortingpuzzle.example"
config/chapter_selection_enabled=false
config/admob_android_rewarded_ad_unit_id=""
config/admob_android_rewarded_life_ad_unit_id=""
config/admob_android_rewarded_ability_ad_unit_id=""
config/admob_android_rewarded_shelf_unlock_ad_unit_id=""
config/admob_android_interstitial_ad_unit_id=""
config/admob_ios_rewarded_ad_unit_id=""
config/admob_ios_rewarded_life_ad_unit_id=""
config/admob_ios_rewarded_ability_ad_unit_id=""
config/admob_ios_rewarded_shelf_unlock_ad_unit_id=""
config/admob_ios_interstitial_ad_unit_id=""

[audio]

buses/default_bus_layout="uid://bubyykk74l0dh"

[autoload]

LocalBackendDebugBootstrap="*res://scripts/save/local_backend_debug_bootstrap.gd"
ChapterCatalog="*res://scripts/chapters/chapter_catalog.gd"
PlayerProgress="*res://scripts/player_progress.gd"
LocaleManager="*res://scripts/localization/locale_manager.gd"
SfxManager="*res://scripts/audio/sfx_manager.gd"
MusicManager="*res://scenes/audio/music_manager.tscn"
HapticsManager="*res://scripts/haptics/haptics_manager.gd"
AdService="*res://scripts/ads/ad_service.gd"
LevelTransition="*res://scripts/level_transition.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/sorting_puzzle_secure_store_bridge/plugin.cfg", "res://addons/admob/plugin.cfg")

[gui]

theme/custom="res://assets/themes/game_typography.tres"

[internationalization]

locale/translations=PackedStringArray("res://assets/translations/en.po", "res://assets/translations/ru.po", "res://assets/translations/uk.po", "res://assets/translations/it.po", "res://assets/translations/ar.po", "res://assets/translations/es.po", "res://assets/translations/pt_BR.po", "res://assets/translations/de.po", "res://assets/translations/fr.po", "res://assets/translations/ko.po", "res://assets/translations/ja.po")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=1
