# Godot 4+ specific ignores
.godot/
/android/

# GAME-003 local-only backend debug override (see local/backend_debug.example.cfg for the template)
/local/backend_debug.cfg

# GAME-003 Android export output (see export_presets.cfg export_path)
/build/

# Python tooling
__pycache__/
*.py[cod]

# IDE metadata
.idea/

# Developer-local generated assets, review captures, and scratch output.
/tmp/*
!/tmp/.gdignore
