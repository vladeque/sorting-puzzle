shader_parameter/outline_radius_px = 0.0

[sub_resource type="Shader" id="Shader_item_shadow"]
code = "shader_type canvas_item;
render_mode unshaded;

// Ground shadow derived from the item's own sprite alpha, so every catalog item casts its own
// form without per-asset shadow authoring. The silhouette is low-pass filtered (a ring average,
// unlike the outline shader's max-dilation) so straws, handles, lids and label details dissolve
// while the overall bottle/box/tub shape survives -- the shadow stays recognizable without being
// a literal copy of the item.
//
// The projection itself lives outside this shader: scenes/item.tscn anchors the sprite on the
// art's ground line (canvas y=240, per docs/ITEM_ASSET_REQUIREMENTS.md) and scripts/item.gd
// squashes, skews and lifts it onto the floor.
uniform vec4 shadow_color : source_color = vec4(0.1, 0.05, 0.02, 0.34);
uniform float blur_radius_px : hint_range(0.0, 64.0, 0.5) = 10.0;
uniform float mask_low : hint_range(0.0, 1.0, 0.01) = 0.3;
uniform float mask_high : hint_range(0.0, 1.0, 0.01) = 0.62;
// Height above the art's ground line, in source texels, over which the mask fades out. 0 keeps
// the whole silhouette (cast projection); a small value keeps only the contact region so the
// shadow reads as a pool whose width still comes from the item (contact pool).
uniform float ground_fade_texels : hint_range(0.0, 256.0, 1.0) = 0.0;
uniform float ground_line_v : hint_range(0.0, 1.0, 0.001) = 0.9375;

const int SHADOW_RING_STEPS = 8;
const float SHADOW_TAU = 6.283185307179586;
const float SHADOW_INNER_RING = 0.55;

void fragment() {
	float coverage = texture(TEXTURE, UV).a;
	float sample_count = 1.0;

	if (blur_radius_px > 0.0) {
		for (int i = 0; i < SHADOW_RING_STEPS; i++) {
			float angle = float(i) / float(SHADOW_RING_STEPS) * SHADOW_TAU;
			vec2 ring = vec2(cos(angle), sin(angle)) * blur_radius_px * TEXTURE_PIXEL_SIZE;
			coverage += texture(TEXTURE, UV + ring * SHADOW_INNER_RING).a;
			coverage += texture(TEXTURE, UV + ring).a;
			sample_count += 2.0;
		}
	}

	float mask = smoothstep(mask_low, mask_high, coverage / sample_count);

	if (ground_fade_texels > 0.0) {
		float height_above_ground =
			(ground_line_v - UV.y) / (ground_fade_texels * TEXTURE_PIXEL_SIZE.y);
		mask *= 1.0 - smoothstep(0.0, 1.0, clamp(height_above_ground, 0.0, 1.0));
	}

	// The fragment color is generated from the alpha mask rather than from the texture's own color,
	// so the incoming COLOR (and with it the item's modulate) is deliberately discarded. Per-item
	// opacity -- the drag lift -- rides on shadow_color's alpha in a per-item material copy instead.
	COLOR = vec4(shadow_color.rgb, shadow_color.a * mask);
}
"

