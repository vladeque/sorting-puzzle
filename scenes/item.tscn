[sub_resource type="Shader" id="Shader_item_outline"]
code = "shader_type canvas_item;

uniform vec4 outline_color : source_color = vec4(1.0, 0.86, 0.18, 1.0);
uniform float outline_width : hint_range(0.0, 8.0, 0.25) = 0.0;
uniform float alpha_threshold : hint_range(0.0, 1.0, 0.01) = 0.1;

void fragment() {
	vec4 vertex_color = COLOR;
	vec4 base_color = texture(TEXTURE, UV);
	vec4 final_color = vec4(0.0);

	if (outline_width > 0.0 && base_color.a <= alpha_threshold) {
		vec2 outline_step = TEXTURE_PIXEL_SIZE * outline_width;
		float outline_alpha = 0.0;
		outline_alpha = max(outline_alpha, texture(TEXTURE, UV + vec2(outline_step.x, 0.0)).a);
		outline_alpha = max(outline_alpha, texture(TEXTURE, UV + vec2(-outline_step.x, 0.0)).a);
		outline_alpha = max(outline_alpha, texture(TEXTURE, UV + vec2(0.0, outline_step.y)).a);
		outline_alpha = max(outline_alpha, texture(TEXTURE, UV + vec2(0.0, -outline_step.y)).a);
		outline_alpha = max(outline_alpha, texture(TEXTURE, UV + outline_step).a);
		outline_alpha = max(outline_alpha, texture(TEXTURE, UV - outline_step).a);
		outline_alpha = max(outline_alpha, texture(TEXTURE, UV + vec2(outline_step.x, -outline_step.y)).a);
		outline_alpha = max(outline_alpha, texture(TEXTURE, UV + vec2(-outline_step.x, outline_step.y)).a);

		if (outline_alpha > alpha_threshold) {
			final_color = vec4(outline_color.rgb, outline_color.a * vertex_color.a);
		}
	}

	COLOR = final_color;
}
"

