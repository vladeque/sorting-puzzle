[sub_resource type="Shader" id="Shader_item_outline"]
code = "shader_type canvas_item;

uniform vec4 outline_color : source_color = vec4(1.0, 0.86, 0.18, 1.0);
uniform float alpha_threshold : hint_range(0.0, 1.0, 0.01) = 0.1;

void fragment() {
	vec4 vertex_color = COLOR;
	vec4 base_color = texture(TEXTURE, UV);
	vec4 final_color = vec4(0.0);

	if (base_color.a > alpha_threshold) {
		final_color = vec4(outline_color.rgb, outline_color.a * base_color.a * vertex_color.a);
	}

	COLOR = final_color;
}
"

