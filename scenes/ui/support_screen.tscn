[node name="HowToPlayItem" parent="ContentMargin/ContentStack/FaqPanel/FaqScroll/FaqList" instance=ExtResource("3_faq_item")]
question = "How do I play?"
answer = "Move matching goods onto the same shelf. When three identical items are visible together, they clear. Complete the board before time runs out."

[node name="ContactSupportItem" parent="ContentMargin/ContentStack/FaqPanel/FaqScroll/FaqList" instance=ExtResource("3_faq_item")]
unique_name_in_owner = true
question = "How do I contact support?"
answer = "Email our support team with a description of the problem."
action_text = "Email Support"
action_id = &"contact_support"

[node name="CrashItem" parent="ContentMargin/ContentStack/FaqPanel/FaqScroll/FaqList" instance=ExtResource("3_faq_item")]
question = "What if the game freezes or crashes?"
answer = "Close and reopen the game first. If it happens again, restart the device and make sure the game is updated. Contact support with the device model, platform version, and what you were doing before the problem."

[node name="SyncItem" parent="ContentMargin/ContentStack/FaqPanel/FaqScroll/FaqList" instance=ExtResource("3_faq_item")]
question = "How do I sync progress between devices?"
answer = "Use the same signed-in platform account on both devices and allow synchronization to finish before playing. If the progress differs, avoid playing on both devices and contact support."

[node name="ReportAdItem" parent="ContentMargin/ContentStack/FaqPanel/FaqScroll/FaqList" instance=ExtResource("3_faq_item")]
unique_name_in_owner = true
question = "How do I report a bad ad?"
answer = "Collect a screenshot and details, then contact support."
action_text = "Email Ad Report"
action_id = &"report_ad"

